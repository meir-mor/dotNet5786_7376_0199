<Window x:Class="PL.Courier.OpenOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Orders" Height="520" Width="820"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Open Orders Available" FontSize="16" FontWeight="Bold" Margin="4"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding OpenOrders}" AutoGenerateColumns="False" Margin="4" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding FullAddress}" Width="2*"/>
                <DataGridTextColumn Header="Aerial (km)" Binding="{Binding AerialDistance}" Width="*"/>
                <DataGridTextColumn Header="Time Remaining" Binding="{Binding TimeRemaining}" Width="*"/>
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Pick" Padding="6,2" Margin="4" Click="BtnPick_Click" CommandParameter="{Binding OrderId}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>