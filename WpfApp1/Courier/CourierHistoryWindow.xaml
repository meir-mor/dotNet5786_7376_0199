<Window x:Class="PL.Courier.CourierHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Courier History" Height="520" Width="820"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded">
    <Grid Margin="8">
        <TextBlock Text="Closed Deliveries (History)" FontSize="16" FontWeight="Bold" Margin="4"/>
        <DataGrid ItemsSource="{Binding Deliveries}" AutoGenerateColumns="False" Margin="4,36,4,4" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Delivery ID" Binding="{Binding DeliveryId}" Width="*"/>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding FullAddress}" Width="2*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding shipmentType}" Width="*"/>
                <DataGridTextColumn Header="Start" Binding="{Binding DeliveryStartTime}" Width="*"/>
                <DataGridTextColumn Header="End" Binding="{Binding DeliveryEndTime}" Width="*"/>
                <DataGridTextColumn Header="End Type" Binding="{Binding DeliveryEndType}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>