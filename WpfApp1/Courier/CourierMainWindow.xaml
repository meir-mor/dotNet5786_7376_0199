<Window x:Class="PL.Courier.CourierMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Courier Dashboard" Height="520" Width="640"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded" Closed="Window_Closed">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Courier Dashboard" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,0,0,15" />

        <Grid Grid.Row="1" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" VerticalAlignment="Center" Margin="4" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCourier.FullName, Mode=TwoWay}" Margin="4" />

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Phone:" VerticalAlignment="Center" Margin="4" />
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay}" Margin="4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="4" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCourier.Email, Mode=TwoWay}" Margin="4" />

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Max Distance (km):" VerticalAlignment="Center" Margin="4" />
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CurrentCourier.MaxDistance, Mode=TwoWay}" Margin="4" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Shipment Type:" VerticalAlignment="Center" Margin="4" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding Source={StaticResource ShipmentTypeItemsKey}}"
                      SelectedValue="{Binding CurrentCourier.ShipmentType, Mode=TwoWay}"
                      Margin="4" />

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Start Work:" VerticalAlignment="Center" Margin="4" />
            <DatePicker Grid.Row="2" Grid.Column="3"
                        SelectedDate="{Binding CurrentCourier.StartWorkTime, Mode=TwoWay}"
                        IsEnabled="False"
                        Margin="4" />
        </Grid>

        <GroupBox Grid.Row="2" Header="Current Order Status" Margin="0,10,0,10">
            <StackPanel Margin="10">
                <StackPanel
                    Visibility="{Binding CurrentCourier.OrderInProgress, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="Order In Progress Details (View Only):" FontWeight="SemiBold"
                               TextDecorations="Underline" Margin="0,0,0,5" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.DeliveryId, StringFormat='Delivery ID: {0}'}"
                        FontSize="14" />
                    <TextBlock Text="{Binding CurrentCourier.OrderInProgress.OrderId, StringFormat='Order ID: {0}'}"
                               FontSize="14" />
                    <TextBlock Text="{Binding CurrentCourier.OrderInProgress.OrderType, StringFormat='Type: {0}'}"
                               FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.Description, StringFormat='Description: {0}'}"
                        FontSize="14"
                        Visibility="{Binding CurrentCourier.OrderInProgress.Description, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock Text="{Binding CurrentCourier.OrderInProgress.FullAddress, StringFormat='Address: {0}'}"
                               FontSize="14" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.AerialDistance, StringFormat='Aerial Distance: {0:F2} km'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.ActualDistance, StringFormat='Actual Distance: {0:F2} km', TargetNullValue='Actual Distance: N/A'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.CustomerFullName, StringFormat='Customer Name: {0}'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.CustomerPhone, StringFormat='Customer Phone: {0}'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.OrderOpenTime, StringFormat='Open Time: {0:g}'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.DeliveryStartTime, StringFormat='Delivery Start: {0:g}'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.ExpectedDeliveryTime, StringFormat='Expected: {0:g}'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.MaxDeliveryTime, StringFormat='Max Time: {0:g}'}"
                        FontSize="14" />
                    <TextBlock Text="{Binding CurrentCourier.OrderInProgress.OrderStatus, StringFormat='Status: {0}'}"
                               FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.ScheduleStatus, StringFormat='Schedule: {0}'}"
                        FontSize="14" />
                    <TextBlock
                        Text="{Binding CurrentCourier.OrderInProgress.TimeRemaining, StringFormat='Time Remaining: {0:hh\\:mm\\:ss}'}"
                        FontSize="14" FontWeight="Bold" />
                </StackPanel>

                <TextBlock Visibility="{Binding CurrentCourier.OrderInProgress, Converter={StaticResource NullToHiddenConverter}}"
                           Foreground="Gray" FontStyle="Italic" HorizontalAlignment="Center" Margin="10" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">

            <Button Content="Update Details" Width="100" Margin="5" Click="BtnUpdate_Click" />

            <!-- Courier actions: Pick Order, Finish Delivery -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsCourier, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Content="Pick Order" Width="110" Margin="5" Click="BtnPickOrder_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentCourier.IsActive}" Value="True" />
                                        <Condition
                                            Binding="{Binding CurrentCourier.OrderInProgress, Converter={StaticResource NullToBoolConverter}}"
                                            Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="True" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Finish Delivery" Width="110" Margin="5" Click="BtnFinishDelivery_Click"
                        IsEnabled="{Binding CurrentCourier.OrderInProgress, Converter={StaticResource NullToBoolConverter}}" />
            </StackPanel>

            <!-- Manager action: Delete -->
            <Button Content="Delete Courier" Width="100" Margin="5" Click="BtnDelete_Click"
                    Visibility="{Binding IsManager, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#FFDDDD" BorderBrush="Red" Foreground="DarkRed" />

            <Button Content="History" Width="100" Margin="5" Click="BtnHistory_Click" />
            <Button Content="Close" Width="80" Margin="5" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>