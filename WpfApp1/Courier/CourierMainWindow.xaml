<Window x:Class="PL.Courier.CourierMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Courier Dashboard" Height="520" Width="640"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Courier Dashboard" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>

        <!-- Form: two-column aligned labels + controls -->
        <Grid Grid.Row="1" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name:" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCourier.FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Phone:" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding CurrentCourier.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCourier.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Max Distance (km):" VerticalAlignment="Center" Margin="4"/>
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CurrentCourier.MaxDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Shipment Type:" VerticalAlignment="Center" Margin="4"/>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      ItemsSource="{Binding Source={StaticResource ShipmentTypeItemsKey}}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding CurrentCourier.ShipmentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="4"/>

            <TextBlock Grid.Row="2" Grid.Column="2" Text="Start Work:" VerticalAlignment="Center" Margin="4"/>
            <DatePicker Grid.Row="2" Grid.Column="3"
                        SelectedDate="{Binding CurrentCourier.StartWorkTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="4"/>
        </Grid>

        <!-- Current order in progress -->
        <GroupBox Grid.Row="2" Header="Current Order (In Progress)" Margin="0,6,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" Margin="6">
                    <TextBlock Text="If there is an order in progress it will show here (read-only)." Foreground="Gray" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CurrentCourier.OrderInProgress.FullAddress, FallbackValue='No current order'}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding CurrentCourier.OrderInProgress.OrderId, StringFormat=Order ID: {0}, FallbackValue=''}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CurrentCourier.OrderInProgress.DeliveryId, StringFormat=Delivery ID: {0}, FallbackValue=''}" Margin="0,0,0,4"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="Update" Width="110" Margin="6" Click="BtnUpdate_Click"/>
            <Button Content="Pick Order" Width="110" Margin="6" Click="BtnPickOrder_Click"/>
            <Button Content="Finish Delivery" Width="130" Margin="6" Click="BtnFinishDelivery_Click"/>
            <Button Content="History" Width="110" Margin="6" Click="BtnHistory_Click"/>
            <Button Content="Close" Width="110" Margin="6" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>