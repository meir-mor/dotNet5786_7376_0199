<Window x:Class="PL.Order.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New Order" Height="450" Width="920"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="EditStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="IsReadOnly" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Add New Order"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15" />

        <!-- Order Info -->
       <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="260" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- LEFT COLUMN -->

    <TextBlock Text="Order Type:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding OrderTypes}"
                      SelectedItem="{Binding CurrentOrder.OrderType, Mode=TwoWay}"
                      Width="240"
                      Margin="5"/>

            <TextBlock Text="Description:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding CurrentOrder.Description, Mode=TwoWay}"
                     Width="240"
                     Style="{StaticResource EditStyle}" />

            <TextBlock Text="Full Address:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding CurrentOrder.FullAddress, Mode=TwoWay}"
                     Width="240"
                     Style="{StaticResource EditStyle}" />

            <TextBlock Text="Customer Name:" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding CurrentOrder.CustomerFullName, Mode=TwoWay}"
                     Width="240"
                     Style="{StaticResource EditStyle}" />

            <TextBlock Text="Order Open Time:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" />
            <Grid Grid.Row="4" Grid.Column="1" Width="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0"
                            SelectedDate="{Binding CurrentOrder.OrderOpenTime, Mode=TwoWay}" />

                <TextBox Grid.Column="1"
                         Text="{Binding CurrentOrder.OrderOpenTime, Mode=TwoWay, StringFormat={}{0:HH:mm}}"
                         Margin="5,0,0,0"/>
            </Grid>

            <TextBlock Text="Expected Delivery Time:" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" />
            <Grid Grid.Row="5" Grid.Column="1" Width="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0"
                            SelectedDate="{Binding CurrentOrder.ExpectedDeliveryTime, Mode=TwoWay}" />

                <TextBox Grid.Column="1"
                         Text="{Binding CurrentOrder.ExpectedDeliveryTimeFormatted, Mode=TwoWay, StringFormat={}{0:HH:mm}}"
                         Margin="5,0,0,0"/>
            </Grid>

            <!-- RIGHT COLUMN -->
            <TextBlock Text="Customer Phone:" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="0" Grid.Column="3"
                     Text="{Binding CurrentOrder.CustomerPhone, Mode=TwoWay}"
                     Width="240"
                     Style="{StaticResource EditStyle}" />

            <TextBlock Text="Volume / Notes:" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="1" Grid.Column="3"
                     Text="{Binding CurrentOrder.Volume, Mode=TwoWay}"
                     Width="240"
                     Style="{StaticResource EditStyle}" />

            <TextBlock Text="Order ID:" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="2" Grid.Column="3"
                     Text="{Binding CurrentOrder.Id}"
                     Width="240"
                     Style="{StaticResource EditStyle}"
                     IsReadOnly="True" />

            <TextBlock Text="Max Delivery Time:" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelStyle}" />
            <Grid Grid.Row="3" Grid.Column="3" Width="240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0"
                            SelectedDate="{Binding CurrentOrder.MaxDeliveryTime, Mode=TwoWay}" />

                <TextBox Grid.Column="1"
                         Text="{Binding CurrentOrder.MaxDeliveryTimeFormatted, Mode=TwoWay, StringFormat={}{0:HH:mm}}"
                         Margin="5,0,0,0"/>
            </Grid>

            <TextBlock Text="Order Status:" Grid.Row="4" Grid.Column="2" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="4" Grid.Column="3"
                     Text="{Binding CurrentOrder.OrderStatus}"
                     Width="240"
                     Style="{StaticResource EditStyle}"
                     IsReadOnly="True" />

            <TextBlock Text="Schedule Status:" Grid.Row="5" Grid.Column="2" Style="{StaticResource LabelStyle}" />
            <TextBox Grid.Row="5" Grid.Column="3"
                     Text="{Binding CurrentOrder.ScheduleStatus}"
                     Width="240"
                     Style="{StaticResource EditStyle}"
                     IsReadOnly="True" />
        </Grid>



        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Add" Width="120" Margin="5" Click="BtnAdd_Click" />
            <Button Content="Close" Width="120" Margin="5" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>