<Window x:Class="PL.Order.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New Order" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="EditStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="IsReadOnly" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add New Order"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- Order Info -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Order Type -->
                <RowDefinition Height="Auto"/>
                <!-- Description -->
                <RowDefinition Height="Auto"/>
                <!-- Full Address -->
                <RowDefinition Height="Auto"/>
                <!-- Customer Name -->
                <RowDefinition Height="Auto"/>
                <!-- Customer Phone -->
                <RowDefinition Height="Auto"/>
                <!-- Volume / Notes -->
                <RowDefinition Height="Auto"/>
                <!-- Order ID -->
                <RowDefinition Height="Auto"/>
                <!-- Order Open Time -->
                <RowDefinition Height="Auto"/>
                <!-- Expected Delivery Time -->
                <RowDefinition Height="Auto"/>
                <!-- Max Delivery Time -->
                <RowDefinition Height="Auto"/>
                <!-- Order Status -->
                <RowDefinition Height="Auto"/>
                <!-- Schedule Status -->
            </Grid.RowDefinitions>

            <TextBlock Text="Order Type:" Grid.Row="0" Style="{StaticResource LabelStyle}"/>
            <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding OrderTypes}"
                        SelectedItem="{Binding CurrentOrder.OrderType, Mode=TwoWay}" Margin="5"/>

            <TextBlock Text="Description:" Grid.Row="1" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.Description, Mode=TwoWay}" Grid.Row="1" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Full Address:" Grid.Row="2" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.FullAddress, Mode=TwoWay}" Grid.Row="2" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Customer Name:" Grid.Row="3" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.CustomerFullName, Mode=TwoWay}" Grid.Row="3" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Customer Phone:" Grid.Row="4" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.CustomerPhone, Mode=TwoWay}" Grid.Row="4" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Volume / Notes:" Grid.Row="5" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.Volume, Mode=TwoWay}" Grid.Row="5" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Order ID:" Grid.Row="6" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.Id}" Grid.Row="6" Grid.Column="1" Style="{StaticResource EditStyle}" IsReadOnly="True"/>

            <TextBlock Text="Order Open Time:" Grid.Row="7" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.OrderOpenTime}" Grid.Row="7" Grid.Column="1" Style="{StaticResource EditStyle}" />

            <TextBlock Text="Expected Delivery Time:" Grid.Row="8" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.ExpectedDeliveryTime}" Grid.Row="8" Grid.Column="1" Style="{StaticResource EditStyle}" />

            <TextBlock Text="Max Delivery Time:" Grid.Row="9" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.MaxDeliveryTime}" Grid.Row="9" Grid.Column="1" Style="{StaticResource EditStyle}" />

            <TextBlock Text="Order Status:" Grid.Row="10" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.OrderStatus}" Grid.Row="10" Grid.Column="1" Style="{StaticResource EditStyle}" IsReadOnly="True"/>

            <TextBlock Text="Schedule Status:" Grid.Row="11" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.ScheduleStatus}" Grid.Row="11" Grid.Column="1" Style="{StaticResource EditStyle}" IsReadOnly="True"/>

        </Grid>



        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Add" Width="120" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Close" Width="120" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
