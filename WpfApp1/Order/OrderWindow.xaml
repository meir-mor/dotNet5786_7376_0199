<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Order Details"
        Height="600" Width="850"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="EditStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="IsReadOnly" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Order Management"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- Order Info -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Order ID:" Grid.Row="0" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.Id}" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}" IsReadOnly="True"/>

            <TextBlock Text="Order Type:" Grid.Row="1" Style="{StaticResource LabelStyle}"/>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding OrderTypes}"
                      SelectedItem="{Binding CurrentOrder.OrderType, Mode=TwoWay}" Margin="5"/>

            <TextBlock Text="Description:" Grid.Row="2" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Grid.Row="2" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Volume / Notes:" Grid.Row="3" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Grid.Row="3" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Customer:" Grid.Row="4" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.CustomerFullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Grid.Row="4" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Phone:" Grid.Row="5" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Grid.Row="5" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Address:" Grid.Row="6" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.FullAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Grid.Row="6" Grid.Column="1" Style="{StaticResource EditStyle}"/>

            <TextBlock Text="Status:" Grid.Row="7" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.OrderStatus}" Grid.Row="7" Grid.Column="1" Style="{StaticResource ValueStyle}" IsReadOnly="True"/>

            <TextBlock Text="Opened At:" Grid.Row="8" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.OrderOpenTime}" Grid.Row="8" Grid.Column="1" Style="{StaticResource ValueStyle}" IsReadOnly="True"/>

            <TextBlock Text="Expected Delivery:" Grid.Row="9" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.ExpectedDeliveryTime}" Grid.Row="9" Grid.Column="1" Style="{StaticResource ValueStyle}" IsReadOnly="True"/>

            <TextBlock Text="Max Delivery Time:" Grid.Row="10" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.MaxDeliveryTime}" Grid.Row="10" Grid.Column="1" Style="{StaticResource ValueStyle}" IsReadOnly="True"/>

            <TextBlock Text="Schedule Status:" Grid.Row="11" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.ScheduleStatus}" Grid.Row="11" Grid.Column="1" Style="{StaticResource ValueStyle}" IsReadOnly="True"/>

            <TextBlock Text="Time Remaining:" Grid.Row="12" Style="{StaticResource LabelStyle}"/>
            <TextBox Text="{Binding CurrentOrder.TimeRemaining}" Grid.Row="12" Grid.Column="1" Style="{StaticResource ValueStyle}" IsReadOnly="True"/>
        </Grid>

        <!-- Deliveries History -->
        <GroupBox Header="Deliveries History"
                  Grid.Row="2"
                  Margin="0,15,0,0">
            <DataGrid ItemsSource="{Binding CurrentOrder.Deliveries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Courier" Binding="{Binding CourierName}" />
                    <DataGridTextColumn Header="Shipment" Binding="{Binding ShipmentType}" />
                    <DataGridTextColumn Header="Start" Binding="{Binding DeliveryStartTime}" />
                    <DataGridTextColumn Header="End Type" Binding="{Binding DeliveryEndType}" />
                    <DataGridTextColumn Header="End Time" Binding="{Binding DeliveryEndTime}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Update" Width="120" Margin="5" Click="BtnSave_Click"/>
            <Button Content="Cancel Order" Width="120" Margin="5" Click="BtnCancel_Click"
                    Visibility="{Binding CurrentOrder.OrderStatus, Converter={StaticResource CancelButtonVisibilityConverter}}"/>
            <Button Content="Close" Width="120" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>

