<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Order Details"
        Height="600" Width="850"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <Style x:Key="EditStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="IsReadOnly" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
      
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Images/order_m1.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>
        
      
        
    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Order Management"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15" />

        <!-- Order Info -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

           <!-- LEFT COLUMN -->
<!-- LEFT COLUMN -->
<TextBlock Text="Order ID:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" />
<TextBox Text="{Binding CurrentOrder.Id}" Grid.Row="0" Grid.Column="1"
         Width="240" Style="{StaticResource ValueStyle}" />

<TextBlock Text="Order Type:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" />
<ComboBox Grid.Row="1" Grid.Column="1"
          Width="240"
          ItemsSource="{Binding OrderTypes}"
          SelectedItem="{Binding CurrentOrder.OrderType}"
          Margin="5" />

<TextBlock Text="Description:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="2" Grid.Column="1"
         Width="240"
         Text="{Binding CurrentOrder.Description}"
         Style="{StaticResource EditStyle}" />

<TextBlock Text="Customer:" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="3" Grid.Column="1"
         Width="240"
         Text="{Binding CurrentOrder.CustomerFullName}"
         Style="{StaticResource EditStyle}" />

<TextBlock Text="Address:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="4" Grid.Column="1"
         Width="240"
         Text="{Binding CurrentOrder.FullAddress}"
         Style="{StaticResource EditStyle}" />

<TextBlock Text="Opened At:" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" />
<Grid Grid.Row="5" Grid.Column="1" Width="240">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="70"/>
    </Grid.ColumnDefinitions>

    <DatePicker Grid.Column="0"
                SelectedDate="{Binding CurrentOrder.OrderOpenTime}"
                IsHitTestVisible="False"
                Focusable="False"/>

    <TextBox Grid.Column="1"
             Text="{Binding CurrentOrder.OrderOpenTime, StringFormat={}{0:HH:mm:ss}}"
             IsReadOnly="True"
             Margin="5,0,0,0"/>
</Grid>

<!-- RIGHT COLUMN -->
<TextBlock Text="Phone:" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="0" Grid.Column="3"
         Width="240"
         Text="{Binding CurrentOrder.CustomerPhone}"
         Style="{StaticResource EditStyle}" />

<TextBlock Text="Volume / Notes:" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="1" Grid.Column="3"
         Width="240"
         Text="{Binding CurrentOrder.Volume}"
         Style="{StaticResource EditStyle}" />

<TextBlock Text="Status:" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="2" Grid.Column="3"
         Width="240"
         Text="{Binding CurrentOrder.OrderStatus}"
         Style="{StaticResource ValueStyle}" />

<TextBlock Text="Expected Delivery:" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelStyle}" />
<Grid Grid.Row="3" Grid.Column="3" Width="240">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="70"/>
    </Grid.ColumnDefinitions>

    <DatePicker Grid.Column="0"
                SelectedDate="{Binding CurrentOrder.ExpectedDeliveryTime}"
                IsHitTestVisible="False"
                Focusable="False"/>

    <TextBox Grid.Column="1"
             Text="{Binding CurrentOrder.ExpectedDeliveryTime, StringFormat={}{0:HH:mm:ss}}"
             IsReadOnly="True"
             Margin="5,0,0,0"/>
</Grid>

<TextBlock Text="Max Delivery Time:" Grid.Row="4" Grid.Column="2" Style="{StaticResource LabelStyle}" />
<Grid Grid.Row="4" Grid.Column="3" Width="240">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="70"/>
    </Grid.ColumnDefinitions>

    <DatePicker Grid.Column="0"
                SelectedDate="{Binding CurrentOrder.MaxDeliveryTime}"
                IsHitTestVisible="False"
                Focusable="False"/>

    <TextBox Grid.Column="1"
             Text="{Binding CurrentOrder.MaxDeliveryTime, StringFormat={}{0:HH:mm:ss}}"
             IsReadOnly="True"
             Margin="5,0,0,0"/>
</Grid>
           

<TextBlock Text="Schedule Status:" Grid.Row="5" Grid.Column="2" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="5" Grid.Column="3"
         Width="240"
         Text="{Binding CurrentOrder.ScheduleStatus}"
         Style="{StaticResource ValueStyle}" />

<TextBlock Text="Time Remaining:" Grid.Row="6" Grid.Column="2" Style="{StaticResource LabelStyle}" />
<TextBox Grid.Row="6" Grid.Column="3"
         Width="240"
         Text="{Binding CurrentOrder.TimeRemaining}"
         Style="{StaticResource ValueStyle}" />


        </Grid>
        
        <Border Grid.Row="2"
                Margin="0,15,0,0"
                Background="#AAE8FAFF"
                CornerRadius="6"
                Padding="6">
            
            <!-- Deliveries History -->
        <GroupBox Header="Deliveries History"   Background="Transparent"
                  BorderThickness="0">
                  
                  
            <DataGrid ItemsSource="{Binding CurrentOrder.Deliveries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Courier" Binding="{Binding CourierName}" />
                    <DataGridTextColumn Header="Shipment" Binding="{Binding ShipmentType}" />
                    <DataGridTextColumn Header="Start" Binding="{Binding DeliveryStartTime}" />
                    <DataGridTextColumn Header="End Type" Binding="{Binding DeliveryEndType}" />
                    <DataGridTextColumn Header="End Time" Binding="{Binding DeliveryEndTime}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        </Border>
        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Update" Width="120" Margin="5" Click="BtnSave_Click"
                    IsEnabled="{Binding CurrentOrder, Converter={StaticResource CancelOrderEnabledConverter}}"/>
            <Button Content="Cancel Order" Width="120" Margin="5" Click="BtnCancel_Click"
                    IsEnabled="{Binding CurrentOrder, Converter={StaticResource CancelOrderEnabledConverter}}"/>
            <Button Content="Close" Width="120" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>