<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        Title="Order List" 
        Height="640" Width="900"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
		mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*" />
            <RowDefinition Height="500*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Filter by Shipment Type:" VerticalAlignment="Center"
                  HorizontalAlignment="Left" />

            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ItemsSource="{Binding Source={StaticResource ShipmentTypeItemsKey}}"
                      SelectedValue="{Binding SelectedShipment, Mode=TwoWay}"
                      SelectionChanged="ShipmentFilter_SelectionChangedOrder"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"/>
        </Grid>

        <DataGrid Grid.Row="1" Margin="5" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  ItemsSource="{Binding OrderList}" 
                  SelectedItem="{Binding SelectedOrder}"
                  SelectionMode="Single"
                  CanUserSortColumns="True" MouseDoubleClick="Order_DoubleClick">  
            
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="*" />
                <DataGridTextColumn Header="Order Type" Binding="{Binding OrderType}" Width="*" />
                <DataGridTextColumn Header="Order Status" Binding="{Binding OrderStatus}" Width="*" />
                <DataGridTextColumn Header="Schedule Status" Binding="{Binding ScheduleStatus}" Width="*" />
                <DataGridTextColumn Header="Shipment Type" Binding="{Binding ShipmentType}" Width="*" />

                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete"
                                    Padding="6,2"
                                    Margin="4"
                                    CommandParameter="{Binding OrderId}"
                                    Click="DeleteOrder_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Height="50" Width="174" Background="#40C4FF" CornerRadius="20"
                Margin="0,10,0,10">
            <Button Content="Add" Background="Transparent" BorderThickness="0" FontSize="14"          
                    FontFamily="Arial Black" Foreground="#FFF93108" FontStyle="Italic" 
                    Click="BtnAdd_Click" />
        </Border>

    </Grid>
</Window>
