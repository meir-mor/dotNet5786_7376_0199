<Application x:Class="PL.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PL"
             xmlns:pl="clr-namespace:PL"
             xmlns:order="clr-namespace:PL"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <!-- ShipmentType items for ComboBox (All + enum values) -->
        <pl:ShipmentTypeItemsCollection x:Key="ShipmentTypeItemsKey" />

        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <!-- Converter to control Cancel button visibility -->
        <local:CancelButtonVisibilityConverter x:Key="CancelButtonVisibilityConverter" />
        <local:NullToHiddenConverter x:Key="NullToHiddenConverter" />
        <local:NullToBoolConverter x:Key="NullToBoolConverter" />
        <local:StatusToBrushConverter x:Key="StatusToBrushConverter" />

        <!-- GLOBAL STYLES -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#AAAAAA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEEEEE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>