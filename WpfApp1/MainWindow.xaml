<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Admin - Main" Height="700" Width="900"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Converters for simulator UI -->
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
        <local:SimulatorButtonTextConverter x:Key="SimulatorButtonTextConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top header -->
        <TextBlock Grid.ColumnSpan="3" Grid.Row="0" Text="Administration - Control Panel"
                   FontSize="18" FontWeight="Bold" Margin="6" />

        <!-- Left: System clock, advance buttons, and Simulator controls -->
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="6" VerticalAlignment="Top">
            <!-- Current system clock (bound to CurrentTime DP) -->
            <Label Content="{Binding CurrentTime}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Left" />

            <!-- Buttons to advance the clock (disabled when simulator is running) -->
            <Button Content="Add One Minute" Click="BtnAdvanceMinute_Click" Margin="4"
                    IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />
            <Button Content="Add One Hour" Click="BtnAdvanceHour_Click" Margin="4"
                    IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />
            <Button Content="Add One Day" Click="BtnAdvanceDay_Click" Margin="4"
                    IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />
            <Button Content="Add One Month" Click="BtnAdvanceMonth_Click" Margin="4"
                    IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />
            <Button Content="Add One Year" Click="BtnAdvanceYear_Click" Margin="4"
                    IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />

            <!-- Simulator Controls Section -->
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,15,0,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Simulator" FontWeight="Bold" Margin="0,0,0,8" />

                    <!-- Interval input (minutes) - disabled when simulator running -->
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Interval (min):" Width="90" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                 IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>

                    <!-- Start/Stop Simulator button -->
                    <Button Content="{Binding IsSimulatorRunning, Converter={StaticResource SimulatorButtonTextConverter}}"
                            Click="BtnToggleSimulator_Click" Margin="4" Padding="8,4" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Center: Configuration variables -->
        <Border Grid.Column="1" Grid.Row="1" Margin="6" Padding="8" BorderBrush="LightGray" BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Configuration (editable)" FontWeight="Bold" Margin="0,0,0,8" />

                <!-- RiskRange -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="RiskRange:" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                </StackPanel>

                <!-- Company Address -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Company Address:" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.ComponyAddress, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" />
                </StackPanel>

                <!-- Manager Password -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Manager Password:" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.ManagerPassword, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" />
                </StackPanel>

                <!-- MaxDistance -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="MaxDistance (km):" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.MaxDistance, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" />
                </StackPanel>

                <!-- Average speeds -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Average Car Speed (km/h):" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.AverageCarSpeed, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" Margin="0,0,12,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Average Bike Speed (km/h):" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.AverageBikeSpeedBike, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Average Bicycle Speed (km/h):" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.AverageBicycleSpeed, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" Margin="0,0,12,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Average Walk Speed (km/h):" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.AverageWalkSpeed, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" />
                </StackPanel>

                <!-- MaxDeliveryTime -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Max Delivery Time:" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.MaxDeliveryTime, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" />
                </StackPanel>

                <!-- TimeToBeDispose -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Time To Be Dispose:" Width="160" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Configuration.TimeToBeDispose, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" />
                </StackPanel>

                <!-- Buttons for configuration actions -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <!-- Updates configuration via BL -->
                    <Button Content="Update Configuration" Click="BtnUpdateConfig_Click" Margin="4" />
                    <!-- Opens list view (sub-screens - NOT disabled when simulator running) -->
                    <Button Content="Manage Courier" Click="BtnOpenListView_Click" Margin="4" />
                    <Button Content="Manage Order" Click="BtnOpenOrderInList_Click" Margin="4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right: DB operations (disabled when simulator is running) -->
        <StackPanel Grid.Column="2" Grid.Row="1" Margin="6" VerticalAlignment="Top">
            <TextBlock Text="Database" FontWeight="Bold" Margin="0,0,0,8" />
            <!-- Initialize DB -->
            <Button Content="Initialize DB" Click="BtnInitializeDb_Click" Margin="4"
                    IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />
            <!-- Reset DB -->
            <Button Content="Reset DB" Click="BtnResetDb_Click" Margin="4"
                    IsEnabled="{Binding IsSimulatorRunning, Converter={StaticResource InverseBoolConverter}}" />
        </StackPanel>
    </Grid>
</Window>